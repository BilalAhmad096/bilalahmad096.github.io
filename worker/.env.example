# Local Worker development only. Copy to worker/.env and never commit secrets.
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=none

# Optional contact and meeting-request delivery via Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=connect@mintorian.com
CONTACT_FROM_EMAIL="Mintorian Website <website@updates.mintorian.com>"

# Use a long random value in production to pseudonymise rate-limit keys.
RATE_LIMIT_SALT=
