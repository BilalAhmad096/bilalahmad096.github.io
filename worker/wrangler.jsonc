{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ask-mintorian-api",
  "account_id": "c88f9d216bdff798ea5f6d9128260354",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "AI_MODEL": "gpt-5.6-luna",
    "AI_REASONING_EFFORT": "none",
    "ALLOWED_ORIGINS": "https://mintorian.com,https://www.mintorian.com,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500",
    "CHAT_RATE_LIMIT": "20",
    "CONTACT_RATE_LIMIT": "5"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "03e3d55b25f84807a976621f84c7c515"
    }
  ],
  "d1_databases": [
    {
      "binding": "INSIGHTS_DB",
      "database_name": "ask-mintorian-insights",
      "database_id": "ca3918e3-0486-4d02-8add-aa1c0ff9c9fc",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 8 * * 1"]
  }
}
